{
    "name": "web-fetch",
    "version": "1.6.0",
    "type": "module",
    "description": "Asset Crawler for common Web pages",
    "keywords": [
        "asset",
        "crawler",
        "browser",
        "web"
    ],
    "license": "LGPL-3.0",
    "author": "shiy2008@gmail.com",
    "homepage": "https://tech-query.me/Web-fetch/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TechQuery/Web-fetch.git"
    },
    "bugs": {
        "url": "https://github.com/TechQuery/Web-fetch/issues"
    },
    "source": "source/index.ts",
    "types": "dist/index.d.ts",
    "module": "dist/index.mjs",
    "main": "dist/index.cjs",
    "bin": "dist/command.js",
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
    },
    "scripts": {
        "prepare": "husky",
        "test": "lint-staged",
        "debug": "rm -rf test/  &&  mkdir test  &&  cd test/  &&  tsx ../source/command.tsx",
        "pack-dist": "rm -rf dist/  &&  pkgroll --src source/",
        "pack-docs": "rm -rf docs/  &&  typedoc source/",
        "build": "npm run pack-dist  &&  npm run pack-docs",
        "prepublishOnly": "npm test  &&  npm run pack-dist",
        "install": "app-find chrome msedge firefox -m 2 -c",
        "start": "npm run pack-docs  &&  open-cli docs/index.html"
    },
    "lint-staged": {
        "*.{md,json,yml,ts}": "prettier --write",
        "*.ts": "eslint --fix"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@tech_query/node-toolkit": "^2.0.0-beta.3",
        "@types/jsdom": "^30.0.0",
        "@types/turndown": "^5.0.6",
        "array-unique-proposal": "^0.3.4",
        "commander-jsx": "^0.8.0",
        "dotenv": "^18.0.5",
        "file-type": "^22.1.1",
        "fs-extra": "^11.4.1",
        "fs-match": "^2.0.1",
        "jsdom": "^30.1.1",
        "lodash.memoize": "^4.1.2",
        "puppeteer-core": "^25.12.0",
        "tslib": "^2.8.1",
        "turndown": "^7.2.4",
        "turndown-plugin-gfm": "^1.0.2",
        "web-utility": "^4.7.2",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.4",
        "@types/lodash.memoize": "^4.1.9",
        "@types/node": "^24.19.1",
        "eslint": "^10.12.0",
        "eslint-idea2app-tsx": "^0.5.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "open-cli": "^9.0.0",
        "pkgroll": "^2.28.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "~6.0.3"
    },
    "prettier": {
        "tabWidth": 4,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "singleQuote": true
    }
}
